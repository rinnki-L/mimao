# mimao — Git ignore
#   - 这是应用（不是库），pubspec.lock 与 *.g.dart 等生成物必须入库
#   - JS 源文件（规则引擎的 Node 验证脚本等）必须入库，只忽略 dart2js 产物

# 常驻资料库 doc/——设计文档、选型 demo（doc/demos/）、环境笔记、上游参考都住这里；只留本地，不进公开仓库
doc/
# ZCode 工作区配置与本地 skill（mimao-dev dev harness 用法），同样只留本地
.zcode/

# 本地临时区 tmp/：一次性材料放这里，用完即删；要长期留的挪进 doc/ 并留一句来历
tmp/

# pub / Dart 工具产物
.dart_tool/
.packages
build/
# flutter test 自举的 native QuickJS 库（Windows 从 build/windows/... 拷到工作目录；
# Linux 在 CI 用插件 CMake 编出 libflutter_qjs_plugin.so 放到仓库根供 dlopen 加载）
flutter_qjs_plugin.dll
libflutter_qjs_plugin.so
# flutter test --coverage 产物；不是生成代码，不入库
coverage/
*.dart.js
*.js_
*.js.deps
*.js.map
*.info.json

# dartdoc 产物
doc/api/

# 环境变量 / 密钥
.env*

# 本机环境搭建日志（只留本地，不进公开仓库）
flutter-download.log
sdk-licenses.log
vsbuildtools-install.log

# Flutter 插件注册文件（各自生成，不入库）
.flutter-plugins
.flutter-plugins-dependencies

# IDE / 编辑器
.idea/
.vscode/
*.iml
.DS_Store

# 操作系统临时文件
Thumbs.db
desktop.ini
