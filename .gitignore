# mimao — Git ignore
#   - 这是应用（不是库），pubspec.lock 与 *.g.dart 等生成物必须入库
#   - JS 源文件（规则引擎的 Node 验证脚本等）必须入库，只忽略 dart2js 产物

# 私人的选型 / 规划材料——只留本地，不进公开仓库
demos/
docs/

# pub / Dart 工具产物
.dart_tool/
.packages
build/
*.dart.js
*.js_
*.js.deps
*.js.map
*.info.json

# dartdoc 产物
doc/api/

# 环境变量 / 密钥
.env*

# Flutter 插件注册文件（各自生成，不入库）
.flutter-plugins
.flutter-plugins-dependencies

# IDE / 编辑器
.idea/
.vscode/
*.iml
.DS_Store

# 操作系统临时文件
Thumbs.db
desktop.ini
